# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000

# PostgreSQL
CLIENT_USERNAME=postgres
CLIENT_PASSWORD=change-me
CLIENT_HOST=localhost
CLIENT_PORT=5432
CLIENT_DATABASE=sprachschule-mank

# Auth: long random string, e.g.  `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS: comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:4200

# First admin — used by scripts/seed-admin.js (only created if no admin exists)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
